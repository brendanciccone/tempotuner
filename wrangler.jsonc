// Static-assets-only Worker: no server code. The presence of this file also
// stops `wrangler deploy` auto-config from detecting Astro and installing the
// @astrojs/cloudflare SSR adapter, which this static site must not use.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tempotuner",
  "compatibility_date": "2026-06-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // No script runs, so there is nothing to log. Each deploy applies this
  // setting and overwrites any change made in the dashboard.
  "observability": {
    "enabled": false
  }
}
