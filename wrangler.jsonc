// Static-assets-only Worker: no server code. The presence of this file also
// stops `wrangler deploy` auto-config from installing the OpenNext SSR adapter,
// which this static-export site must not use.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tempotuner",
  "compatibility_date": "2026-06-12",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  // Mirrors the dashboard settings so deploys don't reset them.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
