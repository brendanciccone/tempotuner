# Served by Cloudflare Workers static assets:
# https://developers.cloudflare.com/workers/static-assets/headers/
# Astro content-hashes everything it emits under /_astro/ (scripts, CSS and the
# self-hosted fonts), so these files are immutable — browsers can cache them
# for a year and skip revalidation.
/_astro/*
  Cache-Control: public,max-age=31536000,immutable
