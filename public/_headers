# Served by Cloudflare Workers static assets:
# https://developers.cloudflare.com/workers/static-assets/headers/
# Astro content-hashes everything it emits under /_astro/ (scripts, CSS and the
# self-hosted fonts), so these files are immutable: browsers can cache them
# for a year and skip revalidation.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The tuner listens through the microphone, so this origin keeps it; nothing
# else, and no embedded frame, gets it.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
